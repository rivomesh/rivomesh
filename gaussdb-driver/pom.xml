<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.rivomesh</groupId><artifactId>rivomesh</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>rivomesh-gaussdb-driver</artifactId>
  <repositories><repository><id>huaweicloud-gaussdb</id><url>https://repo.huaweicloud.com/repository/maven/huaweicloudsdk/</url></repository></repositories>
  <dependencies><dependency><groupId>gsjdbc4</groupId><artifactId>gsjdbc4</artifactId><version>1.1</version><optional>true</optional></dependency></dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version><configuration><forceCreation>true</forceCreation></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <relocations><relocation><pattern>org.postgresql</pattern><shadedPattern>io.github.rivomesh.gaussdb.jdbc</shadedPattern></relocation></relocations>
      <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter></filters>
      <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
    </configuration></execution></executions></plugin>
  </plugins></build>
</project>
