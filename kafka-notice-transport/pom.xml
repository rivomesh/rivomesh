<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.rivomesh</groupId>
    <artifactId>rivomesh</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>rivomesh-kafka-notice-transport</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>4.1.2</version>
      <optional>true</optional>
      <exclusions>
        <exclusion><groupId>com.github.luben</groupId><artifactId>zstd-jni</artifactId></exclusion>
        <exclusion><groupId>at.yawk.lz4</groupId><artifactId>lz4-java</artifactId></exclusion>
        <exclusion><groupId>org.lz4</groupId><artifactId>lz4-java</artifactId></exclusion>
        <exclusion><groupId>org.xerial.snappy</groupId><artifactId>snappy-java</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><forceCreation>true</forceCreation></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions><execution>
          <goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <artifactSet><includes><include>org.apache.kafka:kafka-clients</include></includes></artifactSet>
            <relocations><relocation>
              <pattern>org.apache.kafka</pattern><shadedPattern>io.github.rivomesh.kafka.notice.internal</shadedPattern>
            </relocation>
              <relocation>
                <pattern>kafka/kafka-version[.]properties$</pattern>
                <shadedPattern>rivomesh-kafka-notice/kafka-version.properties</shadedPattern>
                <rawString>true</rawString>
              </relocation>
              <relocation>
                <pattern>^common/message/</pattern>
                <shadedPattern>rivomesh-kafka-notice/common/message/</shadedPattern>
                <rawString>true</rawString>
              </relocation>
              <relocation>
                <pattern>^LICENSE$</pattern>
                <shadedPattern>META-INF/rivomesh-licenses/kafka-clients-4.1.2-LICENSE</shadedPattern>
                <rawString>true</rawString>
              </relocation>
              <relocation>
                <pattern>^NOTICE$</pattern>
                <shadedPattern>META-INF/rivomesh-licenses/kafka-clients-4.1.2-NOTICE</shadedPattern>
                <rawString>true</rawString>
              </relocation>
            </relocations>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
            </transformers>
            <filters><filter><artifact>*:*</artifact><excludes>
              <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude>
            </excludes></filter></filters>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
